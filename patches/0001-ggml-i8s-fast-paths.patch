+// ---------------------------------------------------------------------------
+// Per-node graph profiler (VIBEASR_NODE_PROFILE=1).
+//
+// Every node is followed by a barrier, so thread 0 can time each one including the
+// wait for stragglers -- which is the number that matters, since that is what the
+// wall clock pays. Two views are accumulated: by section, delimited by tensors named
+// "MARK:<name>" that the caller plants at boundaries, and by ggml op, which is what
+// says whether time goes to arithmetic or to data movement.
+//
+// Off by default; the timing itself costs two clock reads per node.
+// ---------------------------------------------------------------------------
+#define VIBEASR_PROF_SLOTS 96
+struct vibeasr_prof_row { char key[64]; int64_t us; int64_t calls; };
+static struct vibeasr_prof_row vibeasr_prof_sec[VIBEASR_PROF_SLOTS];
+static struct vibeasr_prof_row vibeasr_prof_op[VIBEASR_PROF_SLOTS];
+static int vibeasr_prof_on = -1;
+static int64_t vibeasr_prof_pending = 0;
+static char vibeasr_prof_cur[64] = "(before first mark)";
+
+static void vibeasr_prof_add(struct vibeasr_prof_row * tab, const char * key, int64_t us) {
+    for (int i = 0; i < VIBEASR_PROF_SLOTS; i++) {
+        if (tab[i].key[0] == 0) {
+            snprintf(tab[i].key, sizeof(tab[i].key), "%s", key);
+            tab[i].us = us; tab[i].calls = 1; return;
+        }
+        if (strcmp(tab[i].key, key) == 0) { tab[i].us += us; tab[i].calls++; return; }
+    }
+}
+
+static void vibeasr_prof_dump_tab(const char * title, struct vibeasr_prof_row * tab) {
+    int64_t tot = 0;
+    for (int i = 0; i < VIBEASR_PROF_SLOTS && tab[i].key[0]; i++) tot += tab[i].us;
+    if (!tot) return;
+    fprintf(stderr, "\n%s  (thread-0 wall, includes barrier waits)\n", title);
+    fprintf(stderr, "  %-30s %10s %8s %10s\n", "key", "ms", "share", "nodes");
+    for (int pass = 0; pass < VIBEASR_PROF_SLOTS; pass++) {
+        int best = -1;
+        for (int i = 0; i < VIBEASR_PROF_SLOTS && tab[i].key[0]; i++) {
+            if (tab[i].calls < 0) continue;
+            if (best < 0 || tab[i].us > tab[best].us) best = i;
+        }
+        if (best < 0) break;
+        fprintf(stderr, "  %-30s %10.1f %7.1f%% %10lld\n", tab[best].key,
+                tab[best].us / 1000.0, 100.0 * tab[best].us / tot,
+                (long long) tab[best].calls);
+        tab[best].calls = -1;
+    }
+    fprintf(stderr, "  %-30s %10.1f\n", "TOTAL", tot / 1000.0);
+}
+
+static void vibeasr_prof_dump(void) {
+    vibeasr_prof_dump_tab("[vibeasr] time by section", vibeasr_prof_sec);
+    vibeasr_prof_dump_tab("[vibeasr] time by ggml op", vibeasr_prof_op);
+}
