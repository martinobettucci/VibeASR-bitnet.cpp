+// ggml_mul_mat_add_dw_direct
+//
+// Depthwise conv without leaving the [C, frames] layout: the ConvNeXt blocks hold
+// activations channel-contiguous, and in that layout the causal k-tap conv is k
+// fused multiply-adds over contiguous vectors. The im2col route this replaces cost
+// two full-tensor transposes and a k-times-expanded copy per mixer -- measured at
+// ~41% of graph time across CONT and IM2COL_ASYM. Same op id so it shares the
+// epilogue (absmax barrier + requantise) and work-buffer sizing; op_params[0]
+// selects the branch.
+
+struct ggml_tensor * ggml_mul_mat_add_dw_direct(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * bias) {
+    GGML_ASSERT(a->type == GGML_TYPE_I8_S);   // w [k, 1, C]
+    GGML_ASSERT(b->type == GGML_TYPE_I8_S);   // x [C, frames]
+    GGML_ASSERT(a->ne[1] == 1 && a->ne[2] == b->ne[0]);
+
+    const int64_t ne[4] = { b->ne[0], b->ne[1], 1, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, b->type, 4, ne);
+
+    ggml_set_op_params_i32(result, 0, 0xD1);
+    result->op     = GGML_OP_MUL_MAT_ADD;
+    result->src[0] = a;
+    result->src[1] = b;
+    result->src[2] = bias;
+
+    return result;
+}
+
+// ggml_mul_mat_add_conv1d
+//
+// Strided causal 1-D conv as a GEMM whose rows are read straight out of x. In the
+// [C, T] activation layout a window of KW frames x IC channels is ONE contiguous
+// slice of KW*IC bytes, and consecutive output frames sit s0*IC bytes apart -- so
+// no im2col materialisation (a KW/s0-fold data expansion) and no [C,T]->[T,C]
+// transpose in front of it. The weight pack is permuted to frame-outer order to
+// match (integer dots are order-invariant: bit-identical to the im2col route).
+// Same op id -> shares the absmax barrier, requantise and work sizing;
+// op_params[0] = 0xC1, [1] = s0, [2] = lp0.
+
+struct ggml_tensor * ggml_mul_mat_add_conv1d(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * w,      // [KW, IC, OC] I8_S
+        struct ggml_tensor  * x,      // [IC, T]      I8_S (unpermuted stage layout)
+        struct ggml_tensor  * bias,   // [OC]         F32
+        int                   s0,
+        int                   lp0) {
+    GGML_ASSERT(w->type == GGML_TYPE_I8_S);
+    GGML_ASSERT(x->type == GGML_TYPE_I8_S);
+    GGML_ASSERT(w->ne[1] == x->ne[0]);            // IC agrees
+    GGML_ASSERT(x->ne[2] == 1 && x->ne[3] == 1);
+    GGML_ASSERT(ggml_is_contiguous(x));
+    GGML_ASSERT((w->ne[0] * w->ne[1]) % 32 == 0); // packed-kernel gate
+
+    const int64_t OW = (x->ne[1] + lp0 - w->ne[0]) / s0 + 1;
+    GGML_ASSERT(OW > 0);
+    const int64_t ne[4] = { w->ne[2], OW, 1, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, x->type, 4, ne);
+
+    ggml_set_op_params_i32(result, 0, 0xC1);
+    ggml_set_op_params_i32(result, 1, s0);
+    ggml_set_op_params_i32(result, 2, lp0);
+    result->op     = GGML_OP_MUL_MAT_ADD;
+    result->src[0] = w;
+    result->src[1] = x;
+    result->src[2] = bias;
+
+    return result;
+}
